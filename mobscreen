-- Find the monitor and modem
local monitor = peripheral.find("monitor")
if not monitor then
    error("No monitor found!")
end
local modem = peripheral.find("modem")
if not modem then
    error("No wireless modem found!")
end

rednet.open(peripheral.getName(modem)) -- Open the wireless modem

local targetComputerID_2 = 2  -- ID for Computer 2
local targetComputerID_3 = 3  -- ID for Computer 3

monitor.setTextScale(1)
monitor.clear()

-- Define buttons for the first set (Blaze, Pyromancer, Enderman, ElderGaurd)
local buttons_1 = {
    {label = "CaveCreeper", x = 4, y = 2, width = 11, height = 3, color = colors.red, active = false},
    {label = "AncKnight", x = 4, y = 6, width = 11, height = 3, color = colors.red, active = false},
    {label = "Spider", x = 4, y = 10, width = 11, height = 3, color = colors.red, active = false},
    {label = "Creeper", x = 4, y = 14, width = 11, height = 3, color = colors.red, active = false}
}

-- Define buttons for the second set (Witch, Wither, Cave Creeper, Ancient Knight)
local buttons_2 = {
    {label = "Witch", x = 16, y = 2, width = 11, height = 3, color = colors.red, active = false},
    {label = "Wither", x = 16, y = 6, width = 11, height = 3, color = colors.red, active = false},
    {label = "Blaze", x = 16, y = 10, width = 11, height = 3, color = colors.red, active = false},
    {label = "Pyromancer", x = 16, y = 14, width = 11, height = 3, color = colors.red, active = false}
}

-- Function to draw a button
local function drawButton(button)
    monitor.setBackgroundColor(button.color)
    monitor.setTextColor(colors.white)

    for i = 0, button.height - 1 do
        monitor.setCursorPos(button.x, button.y + i)
        monitor.write(string.rep(" ", button.width))
    end

    local labelX = button.x + math.floor((button.width - #button.label) / 2)
    local labelY = button.y + math.floor(button.height / 2)
    monitor.setCursorPos(labelX, labelY)
    monitor.write(button.label)

    monitor.setBackgroundColor(colors.black) -- Reset background
end

-- Function to draw all buttons (both sets)
local function drawButtons()
    for _, button in ipairs(buttons_1) do
        drawButton(button)
    end
    for _, button in ipairs(buttons_2) do
        drawButton(button)
    end
end

-- Function to check if a touch is within a button's bounds
local function isTouchInButton(x, y, button)
    return x >= button.x and x < (button.x + button.width) and y >= button.y and y < (button.y + button.height)
end

-- Function to toggle button state and send a signal
local function toggleButton(button, targetComputerID)
    button.active = not button.active

    -- Change button color
    if button.active then
        button.color = colors.green
    else
        button.color = colors.red
    end
    
    drawButton(button)

    -- Send signal to the correct computer
    local targetID = targetComputerID
    rednet.send(targetID, button.label .. ":" .. (button.active and "on" or "off"))
    print("Sent to Computer " .. targetID .. ": " .. button.label .. " -> " .. (button.active and "on" or "off"))
end

-- Main program loop
local function main()
    drawButtons()

    while true do
        local event, side, x, y = os.pullEvent("monitor_touch")

        -- Check which button was clicked in the first set
        for _, button in ipairs(buttons_1) do
            if isTouchInButton(x, y, button) then
                toggleButton(button, targetComputerID_2)
                break
            end
        end

        -- Check which button was clicked in the second set
        for _, button in ipairs(buttons_2) do
            if isTouchInButton(x, y, button) then
                toggleButton(button, targetComputerID_3)
                break
            end
        end
    end
end

main()
