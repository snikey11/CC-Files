local modem = peripheral.find("modem")
if not modem then
    error("No wireless modem found!")
end

rednet.open(peripheral.getName(modem))

print("Listening for signals...")

-- Add ALL names from Computer 1 here:
local redstoneMapping = {
    -- From first set
    Blaze = "left",
    Wither = "back",
    Witch = "right",
    Creeper = "front",

    -- From second set
    Pyro = "left",
    Enderman = "back",
    CaveCreeper = "right",
    AncKnight = "front"
}

while true do
    local senderId, message = rednet.receive()

    -- Safely force message to string
    message = tostring(message)

    -- Expect "Name:on/off"
    local name, state = message:match("([^:]+):([^:]+)")

    if name and state then
        local side = redstoneMapping[name]

        if side then
            local active = (state == "on")
            redstone.setAnalogOutput(side, active and 1 or 0)
            print("Set " .. side .. " to " .. (active and "1" or "0"))
        else
            print("Unknown name from Computer 1: " .. name)
        end
    else
        print("Invalid message received: " .. message)
    end
end
