-- Setup peripherals
local monitor = peripheral.find("monitor")
if not monitor then error("No monitor found") end

local relays = peripheral.findAll("redstone_relay")
if #relays == 0 then error("No redstone relays found") end

-- Button state
local button = {
    label = "Toggle Spawners",
    x = 2,
    y = 3,
    width = 20,
    height = 5,
    active = false
}

-- Draw button
local function drawButton()
    monitor.setBackgroundColor(button.active and colors.green or colors.red)
    for i = 0, button.height - 1 do
        monitor.setCursorPos(button.x, button.y + i)
        monitor.write(string.rep(" ", button.width))
    end
    local labelX = button.x + math.floor((button.width - #button.label) / 2)
    local labelY = button.y + math.floor(button.height / 2)
    monitor.setCursorPos(labelX, labelY)
    monitor.setTextColor(colors.white)
    monitor.write(button.label)
    monitor.setBackgroundColor(colors.black)
end

-- Toggle relays
local function toggleRelays(state)
    for _, relay in ipairs(relays) do
        relay.setOutput("top", state)
    end
end

-- Init
monitor.setTextScale(1)
monitor.setBackgroundColor(colors.black)
monitor.clear()
drawButton()

-- Main loop
while true do
    local event, side, x, y = os.pullEvent("monitor_touch")
    if x >= button.x and x < button.x + button.width and y >= button.y and y < button.y + button.height then
        button.active = not button.active
        toggleRelays(button.active)
        drawButton()
    end
end
