-- Find and initialize the monitor
local monitor = peripheral.find("monitor")
if not monitor then error("No monitor found!") end
monitor.setTextScale(1)
monitor.clear()

-- Discover all redstone relays and index them by numeric ID
local relays = {}
for _, name in ipairs(peripheral.getNames()) do
    if peripheral.getType(name) == "redstoneIntegrator" or peripheral.getType(name) == "redstoneRelay" then
        local id = tonumber(name:match("(%d+)$"))
        if id then
            relays[id] = peripheral.wrap(name)
        end
    end
end

-- Validate that all 16 relays are found
for i = 0, 15 do
    if not relays[i] then
        print("Warning: Relay with ID " .. i .. " not found on the network.")
    end
end

-- Define button data
local buttons = {
    {
        label = "Left Spawner",
        x = 2, y = 2, width = 15, height = 5,
        color = colors.red,
        active = false,
        ids = {0, 1, 2, 3, 4, 5, 6, 7}
    },
    {
        label = "Right Spawner",
        x = 2, y = 8, width = 15, height = 5,
        color = colors.red,
        active = false,
        ids = {8, 9, 10, 11, 12, 13, 14, 15}
    }
}

-- Draw a single button
local function drawButton(button)
    monitor.setBackgroundColor(button.color)
    monitor.setTextColor(colors.white)
    for i = 0, button.height - 1 do
        monitor.setCursorPos(button.x, button.y + i)
        monitor.write(string.rep(" ", button.width))
    end
    local labelX = button.x + math.floor((button.width - #button.label) / 2)
    local labelY = button.y + math.floor(button.height / 2)
    monitor.setCursorPos(labelX, labelY)
    monitor.write(button.label)
    monitor.setBackgroundColor(colors.black)
end

-- Draw all buttons
local function drawButtons()
    for _, button in ipairs(buttons) do
        drawButton(button)
    end
end

-- Check if a touch is inside a button
local function isTouchInButton(x, y, button)
    return x >= button.x and x < (button.x + button.width) and y >= button.y and y < (button.y + button.height)
end

-- Toggle a button and send redstone output to its relays
local function toggleButton(button)
    button.active = not button.active
    button.color = button.active and colors.green or colors.red
    drawButton(button)

    for _, id in ipairs(button.ids) do
        local relay = relays[id]
        if relay then
            relay.setOutput("top", button.active)
        else
            print("Relay ID " .. id .. " not available.")
        end
    end
end

-- Main event loop
local function main()
    drawButtons()
    while true do
        local event, side, x, y = os.pullEvent("monitor_touch")
        for _, button in ipairs(buttons) do
            if isTouchInButton(x, y, button) then
                toggleButton(button)
                break
            end
        end
    end
end

main()
